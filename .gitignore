# ==============================================================================
# CrawlRAG - Git Ignore Configuration
# ==============================================================================

# 🐍 Python Virtual Environments
venv/
.venv/
env/
ENV/
bin/
lib/
include/

# 🐍 Python Compiler & Cache Files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# 📁 Local Storage & Data (Generated runtime data)
data/*
backend/data/*

# 🤖 Downloaded Machine Learning Models
models/*
backend/models/*

# 🔑 Environment Configurations & Secrets
# Ignore local environment files containing credentials and settings
.env
backend/.env
.env.local
backend/.env.local
.env.development.local
.env.test.local
.env.production.local

# DO NOT ignore the env example template
!.env.example
!backend/.env.example

# 💻 OS / IDE / Editor Specific Files
.vscode/
.idea/
.DS_Store
Thumbs.db
logs/*
backend/logs/*

# 📦 Node / Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
