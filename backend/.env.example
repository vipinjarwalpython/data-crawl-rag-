# ==============================================================================
# CrawlRAG - Environment Configuration Template (.env.example)
# Copy this file to `.env` in the same directory and customize the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🚀 Application & Server Settings
# ------------------------------------------------------------------------------
APP_NAME=CrawlRAG
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 📁 Custom Storage Directories (Relative to workspace root or absolute)
# ------------------------------------------------------------------------------
DATA_DIR=data
SCRAPED_DIR=data/scraped
CLEAN_DATA_DIR=data/clean_data
CHUNKED_DATA_DIR=data/chunked_data
VECTOR_STORE_DIR=data/vector_store
MODELS_DIR=models
EMBEDDINGS_DIR=models/embeddings
LLM_DIR=models/llm

# ------------------------------------------------------------------------------
# 🕷️ Web Scraping Defaults
# ------------------------------------------------------------------------------
# Default User Agent sent with browser and HTTP requests
DEFAULT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36 CrawlRAG/1.0"

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30.0

# Rate limiting and concurrency controls
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY_SECONDS=0.5

# Crawling boundaries
DEFAULT_MAX_DEPTH=2
DEFAULT_MAX_PAGES=50

# ------------------------------------------------------------------------------
# 🤖 Embedding & RAG Pipeline Config
# ------------------------------------------------------------------------------
# Local embedding model name (cached in models/embeddings/)
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Chunker configuration
DEFAULT_CHUNK_SIZE=400
DEFAULT_CHUNK_OVERLAP=80

# Local LLM instruction model name (cached in models/llm/)
DEFAULT_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1

# RAG Retrieval
RETRIEVAL_TOP_K=7
RETRIEVAL_SCORE_THRESHOLD=0.2

# ------------------------------------------------------------------------------
# 🔑 External Integrations & Secrets
# ------------------------------------------------------------------------------
# Optional: Hugging Face User Access Token (Required if downloading gated/private models)
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here
