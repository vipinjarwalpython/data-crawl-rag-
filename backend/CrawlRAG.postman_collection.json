{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "CrawlRAG — Full API Collection",
    "description": "Complete Postman collection for CrawlRAG v0.3.0.\n\nUnified Single Endpoint Flow (POST /api/v1/rag/answer):\n  1. Checks Vector Store (dense vector + keyword hybrid search)\n  2. If Vector Store has no relevant info (or weak coverage) → Fallback to PostgreSQL (NL-to-SQL)\n  3. If PostgreSQL also has no info → Graceful response ('I don't have information about that...')\n\nModels used:\n  • Embeddings: BAAI/bge-small-en-v1.5 (384-dim, dense vector search)\n  • LLM:        Qwen/Qwen2.5-1.5B-Instruct (local instruction-tuned model)\n  • Database:   PostgreSQL (structured data fallback layer)\n\nBase URL variable: {{base_url}} = http://127.0.0.1:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "FastAPI server base URL"
    },
    {
      "key": "doc_id",
      "value": "doc_example123",
      "type": "string",
      "description": "Replace with an actual doc_id from the List Documents response"
    }
  ],
  "item": [
    {
      "name": "0. Health & Info",
      "description": "Start here to confirm the server and PostgreSQL connection are active.",
      "item": [
        {
          "name": "Root Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Returns API metadata, version (v0.3.0), active modules, and endpoint routes."
          },
          "response": []
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Returns server status, environment mode, log file location, and active storage paths."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Web Scraping",
      "description": "Step 1 of the pipeline. Crawl a website and save each page as a JSON document in data/scraped/.",
      "item": [
        {
          "name": "Scrape Website (Full Recursive Crawl)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://books.toscrape.com/\",\n  \"max_depth\": 2,\n  \"max_pages\": 50,\n  \"render_js\": true,\n  \"wait_seconds\": 2.0,\n  \"concurrency\": 3,\n  \"delay_seconds\": 0.5,\n  \"stay_within_path\": false,\n  \"crawl_external_links\": false,\n  \"force_refresh\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/scraping/scrape",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "scraping", "scrape"]
            },
            "description": "BFS recursive crawl from the seed URL using Playwright for JS hydration."
          },
          "response": []
        },
        {
          "name": "Scrape Single Page (Fast, No JS)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://books.toscrape.com/catalogue/category/books/mystery_3/index.html\",\n  \"max_depth\": 0,\n  \"max_pages\": 1,\n  \"render_js\": false,\n  \"delay_seconds\": 0.0,\n  \"force_refresh\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/scraping/scrape",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "scraping", "scrape"]
            },
            "description": "Scrape a single static HTML page quickly without JavaScript rendering."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Document Store",
      "description": "Inspect, list, retrieve, and delete scraped JSON documents.",
      "item": [
        {
          "name": "List All Scraped Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/scraping/documents?skip=0&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "scraping", "documents"],
              "query": [
                { "key": "skip", "value": "0", "description": "Pagination offset" },
                { "key": "limit", "value": "50", "description": "Max documents to return" }
              ]
            },
            "description": "Returns metadata list of saved scraped documents."
          },
          "response": []
        },
        {
          "name": "Get Document by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/scraping/documents/{{doc_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "scraping", "documents", "{{doc_id}}"]
            },
            "description": "Fetch the full JSON document content by doc_id."
          },
          "response": []
        },
        {
          "name": "Delete Document by ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/scraping/documents/{{doc_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "scraping", "documents", "{{doc_id}}"]
            },
            "description": "Deletes a scraped JSON document from disk."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. RAG Pipeline — Ingestion",
      "description": "Ingestion stages to clean, chunk, and embed scraped content.",
      "item": [
        {
          "name": "⭐ Embed All (One-Shot Ingestion)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batch_size\": 32\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/rag/embed-all",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rag", "embed-all"]
            },
            "description": "Runs full ingestion (clean → chunk → embed → store) in a single call."
          },
          "response": []
        },
        {
          "name": "Check Pipeline Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rag/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rag", "status"]
            },
            "description": "Returns vector store statistics, document counts, and model cache status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Unified Search & Answer Endpoint ⭐",
      "description": "SINGLE ENDPOINT for all Q&A functionality: POST /api/v1/rag/answer\n\nPriority Order:\n  1. Vector Store Hit → Grounded Answer + Chunks Sources\n  2. Vector Store Miss → PostgreSQL Fallback (NL to SQL) → Structured Rows\n  3. Neither Has Info → Graceful Sentinel Response ('I don't have information...')",
      "item": [
        {
          "name": "1. Vector Store Hit (Scraped Data Answer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Tell me about Lab Girl book — its price, category and availability\",\n  \"top_k\": 7,\n  \"score_threshold\": 0.35,\n  \"reframe\": true,\n  \"temperature\": 0.1,\n  \"max_new_tokens\": 512\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/rag/answer",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rag", "answer"]
            },
            "description": "Demonstrates Vector Store Hit: data exists in scraped vector chunks. Returns LLM answer + source chunks list."
          },
          "response": []
        },
        {
          "name": "2. PostgreSQL Fallback Hit (Structured DB Answer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Which Porsche models cost more than 300000 USD?\",\n  \"top_k\": 5,\n  \"score_threshold\": 0.35,\n  \"reframe\": true,\n  \"temperature\": 0.1,\n  \"max_new_tokens\": 512\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/rag/answer",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rag", "answer"]
            },
            "description": "Demonstrates PostgreSQL Fallback Hit: vector store context is missing/weak, so system converts query to SQL and fetches records from PostgreSQL cars table. Returns DB rows with sources: []."
          },
          "response": []
        },
        {
          "name": "3. Graceful Out-of-Context (Neither DB Hit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"what is score of india vs pakistan match?\",\n  \"top_k\": 5,\n  \"score_threshold\": 0.35,\n  \"reframe\": true,\n  \"temperature\": 0.1,\n  \"max_new_tokens\": 512\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/rag/answer",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rag", "answer"]
            },
            "description": "Demonstrates Out-of-Context Response: query is absent in both Vector Store and PostgreSQL DB. Returns clean sentinel answer ('I don't have information...') with sources: []."
          },
          "response": []
        }
      ]
    },
