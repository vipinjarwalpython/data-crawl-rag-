  "item": [
    {
      "name": "1. Primary Unified Scraper",
      "item": [
        {
          "name": "⚡ Scrape & Auto-Crawl Website (Full Accuracy)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://humanixtechnologies.com/\",\n  \"max_depth\": 2,\n  \"max_pages\": 10,\n  \"render_js\": true,\n  \"wait_seconds\": 2.5,\n  \"concurrency\": 2,\n  \"delay_seconds\": 0.5,\n  \"force_refresh\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/scraping/scrape",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "scraping", "scrape"]
            },
            "description": "ONE Unified Endpoint:\n1. Takes 1 seed URL.\n2. Renders dynamic JavaScript / React SPAs.\n3. Extracts main page content + all words and headings.\n4. Discovers all internal links and automatically crawls each subpage.\n5. Saves each page into its own JSON file in data/scraped/.\n6. Returns the full structured JSON for EVERY scraped page in the response body."
          },
          "response": []
        }
      ]
    },
